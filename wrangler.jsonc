{
  "name": "le-comrade",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "le-comrade-content",
      "database_id": "e83adaf2-9c8e-46b3-ae8e-aa755c3a1edf"
    }
  ]
}
