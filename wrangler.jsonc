{
  "name": "le-comrade",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "build": {
    "command": "npm run build"
  },
  "main": "./src/pledge-worker.js",
  "kv_namespaces": [
    {
      "binding": "PLEDGES"
    }
  ]
}
